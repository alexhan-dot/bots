# 복사해서 env.yaml 로 저장 후 값 채우기 (env.yaml은 git에 올리지 말 것)
SHEET_ID: "1fMQDRmGVVtaUR0cVBzzSaowHU38clVuON1PoxGWCT_A"   # Lineage Schedule v2 (기존 수기 시트 아님)
ANTHROPIC_API_KEY: "sk-ant-..."
CLAUDE_MODEL: "claude-sonnet-4-6"

BOT_TZ: "Asia/Seoul"                 # '오늘' 기준 시간대 (Cloud Run은 UTC라 필수). 필리핀 기준이면 Asia/Manila

TELEGRAM_BOT_TOKEN: "123456789:AAxxxxxxxx"
ADMIN_CHAT_ID: "111111111"          # 대표 텔레그램 chat_id
SALES_CHAT_IDS: "222222222,333333333"   # 영업자 chat_id (쉼표 구분)

# 선택: 웹훅 위조 방지. 영문/숫자/_/- 로 32자 정도 (예: openssl rand -hex 16). deploy.sh가 텔레그램에 자동 등록
TELEGRAM_WEBHOOK_SECRET: ""

# 디스코드 — tools/setup_discord.py 가 아래 값을 자동으로 채움 (새 서버에 역할·채널 생성)
DISCORD_BOT_TOKEN: ""                # Developer Portal > Bot > Reset Token. 영업 요청 카드·기록 채널 발송에 사용
DISCORD_APP_ID: ""
DISCORD_PUBLIC_KEY: ""               # 요청 서명 검증
DISCORD_GUILD_ID: ""
DISCORD_MANAGER_ROLE_IDS: ""         # 명령·버튼 쓸 수 있는 역할 (Manager). 비우면 서버 전원
DISCORD_URGENT_ROLE_ID: ""           # 긴급(재접속) 카드에서 멘션할 역할
DISCORD_REQUESTS_CHANNEL_ID: ""      # #sales-requests — 텔레그램 영업 요청 카드
DISCORD_LOG_CHANNEL_ID: ""           # #bot-log — 저장 기록
DISCORD_CONFIRM_CHANNEL_ID: ""       # #schedule-confirm — 일별·주별 컨펌 카드
DISCORD_REPORTS_CHANNEL_ID: ""       # #shift-reports — 플레이어 스크린샷
DISCORD_AI_MODEL: "claude-opus-5"    # /log 자유 입력 해석용 (effort low)
DISCORD_WEBHOOK_URL: ""              # (선택) 봇 토큰 없이 쓸 때만 — 텍스트+링크 알림


# 카카오 상담톡(TalkBridge) — 보류. 비워두면 /kakao/webhook 은 401만 반환
TALKBRIDGE_BRAND_KEY: ""
TALKBRIDGE_AGENT_KEY: ""
TALKBRIDGE_WHSEC: ""

BOT_BASE_URL: ""                     # (선택) 웹훅 폴백 링크용. 디스코드 카드를 쓰면 불필요
